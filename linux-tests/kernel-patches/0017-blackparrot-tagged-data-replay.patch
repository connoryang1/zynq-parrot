+/* Modes nine and ten replace per-line wakeup CSR writes with one footprint
+ * tag. The pinned pages and hardware table are prepared by prctl before the
+ * measured handoff; mode ten additionally launches instruction replay.
+ */
+static __always_inline void riscv_bp_replay_wakeup(struct task_struct *task)
+{
+	unsigned long slot;
+
+	if ((READ_ONCE(task->thread.bp_preview_phys_mode) != 9
+	     && READ_ONCE(task->thread.bp_preview_phys_mode) != 10)
+	    || !READ_ONCE(task->thread.bp_preview_replay_configured)
+	    || READ_ONCE(task->thread.bp_preview_phys_mm) != task->mm
+	    || !task->mm)
+		return;
+	slot = READ_ONCE(task->thread.bp_preview_replay_slot);
+	asm volatile("csrw 0x9c3, %0" : : "r"(slot) : "memory");
+	WRITE_ONCE(task->thread.bp_preview_hook_count,
+		   READ_ONCE(task->thread.bp_preview_hook_count) + 1);

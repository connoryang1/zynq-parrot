+
+/* Arm mode eleven only after a successful wake. A configured-but-unarmed task
+ * can be preempted before it blocks without consuming its future replay.
+ */
+static __always_inline void riscv_bp_replay_arm_late(struct task_struct *task)
+{
+	if (READ_ONCE(task->thread.bp_preview_phys_mode) != 11
+	    || READ_ONCE(task->thread.bp_preview_replay_state) != 1
+	    || READ_ONCE(task->thread.bp_preview_phys_mm) != task->mm
+	    || !task->mm)
+		return;
+	WRITE_ONCE(task->thread.bp_preview_replay_state, 2);
+}
+
+/* Consume one successful-wakeup arm at the final architecture hook. Returning
+ * the state to configured prevents later reschedules from replaying again.
+ */
+static __always_inline void riscv_bp_replay_late(struct task_struct *task)
+{
+	unsigned long slot, start, end;
+
+	if (READ_ONCE(task->thread.bp_preview_phys_mode) != 11
+	    || READ_ONCE(task->thread.bp_preview_replay_state) != 2
+	    || READ_ONCE(task->thread.bp_preview_phys_mm) != task->mm
+	    || !task->mm)
+		return;
+	WRITE_ONCE(task->thread.bp_preview_replay_state, 1);
+	slot = READ_ONCE(task->thread.bp_preview_replay_slot);
+	asm volatile("csrr %0, 0xcc0" : "=r"(start) : : "memory");
+	asm volatile("csrw 0x9c3, %0" : : "r"(slot) : "memory");
+	asm volatile("csrr %0, 0xcc0" : "=r"(end) : : "memory");
+	WRITE_ONCE(task->thread.bp_preview_last_hook_cycles, end - start);
+	WRITE_ONCE(task->thread.bp_preview_hook_count,
+		   READ_ONCE(task->thread.bp_preview_hook_count) + 1);
+}
 

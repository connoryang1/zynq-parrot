This patch adds a source-level mode for hardware-sequenced joint replay. Mode
twelve issues one tagged data-footprint command at successful wakeup with a
follow bit that launches shared instruction-prefix replay only after the data
controller and its downstream D-UCE state drain. No final-selection software
hook is needed.

--- a/arch/riscv/include/asm/switch_to.h
+++ b/arch/riscv/include/asm/switch_to.h
@@ -216 +216,2 @@
-	     && READ_ONCE(task->thread.bp_preview_phys_mode) != 10)
+	     && READ_ONCE(task->thread.bp_preview_phys_mode) != 10
+	     && READ_ONCE(task->thread.bp_preview_phys_mode) != 12)
@@ -221,0 +223,2 @@
+	if (READ_ONCE(task->thread.bp_preview_phys_mode) == 12)
+		slot |= 1UL << 2;
--- a/include/uapi/linux/prctl.h
+++ b/include/uapi/linux/prctl.h
@@ -314 +314,2 @@
-/* 0 off; 1 wake joint; 2 select joint; 3--8 controls; 9--11 tagged replay. */
+/* 0 off; 1 wake joint; 2 select joint; 3--8 controls; 9--11 tagged replay;
+ * 12 hardware-sequenced tagged-data then instruction replay. */
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -4370 +4370,2 @@
-		if (bp_preview_mode == 9 || bp_preview_mode == 10)
+		if (bp_preview_mode == 9 || bp_preview_mode == 10
+		    || bp_preview_mode == 12)
@@ -6715 +6716,2 @@
-		    && bp_preview_mode != 11) {
+		    && bp_preview_mode != 11
+		    && bp_preview_mode != 12) {
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -2791 +2791 @@
-		if (arg2 > 11 || arg3 || arg4 || arg5) {
+		if (arg2 > 12 || arg3 || arg4 || arg5) {

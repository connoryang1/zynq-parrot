This patch makes physical data-preview timing selectable without rebuilding the
kernel. Mode one issues at exact scheduler selection; mode two issues immediately
before the architectural register/stack switch to reduce tiny-L2 displacement.

--- a/arch/riscv/include/asm/processor.h
+++ b/arch/riscv/include/asm/processor.h
@@ -89,7 +89,7 @@
 	struct page *bp_preview_pin[BP_PREVIEW_ADDRS];
 	unsigned long bp_preview_paddr[BP_PREVIEW_ADDRS];
 	struct mm_struct *bp_preview_phys_mm;
-	bool bp_preview_phys_enabled;
+	unsigned char bp_preview_phys_mode;
 	unsigned long bp_preview_hook_count;
 	/* Diagnostic counts for each incoming context-switch guard outcome. */
 	unsigned long bp_preview_guard_count[5];
--- a/arch/riscv/include/asm/switch_to.h
+++ b/arch/riscv/include/asm/switch_to.h
@@ -81,6 +81,7 @@
 		__switch_to_fpu(__prev, __next);	\
 	if (has_vector())					\
 		__switch_to_vector(__prev, __next);	\
+	riscv_bp_preview_late(__next);			\
 	((last) = __switch_to(__prev, __next));		\
 } while (0)
 
@@ -102,7 +103,7 @@
 	/* Pinned pages remain valid across an address-space switch. The custom
 	 * supervisor CSR queues an L2-only physical read without the target DTLB.
 	 */
-	if (READ_ONCE(next->thread.bp_preview_phys_enabled)
+	if (READ_ONCE(next->thread.bp_preview_phys_mode) == 1
 	    && READ_ONCE(next->thread.bp_preview_phys_mm) == next->mm
 	    && next->mm) {
 		paddr0 = READ_ONCE(next->thread.bp_preview_paddr[0]);
@@ -160,5 +161,34 @@
 	WRITE_ONCE(next->thread.bp_preview_hook_count,
 		   READ_ONCE(next->thread.bp_preview_hook_count) + 1);
 }
+
+/* Mode two deliberately issues after MM/FPU/vector switch preparation and
+ * immediately before the architectural register/stack switch. This retains
+ * enough memory lead while minimizing tiny-L2 displacement before first use. */
+static __always_inline void riscv_bp_preview_late(struct task_struct *next)
+{
+	unsigned long paddr0, paddr1, paddr2, paddr3;
+
+	if (READ_ONCE(next->thread.bp_preview_phys_mode) != 2
+	    || READ_ONCE(next->thread.bp_preview_phys_mm) != next->mm
+	    || !next->mm)
+		return;
+	paddr0 = READ_ONCE(next->thread.bp_preview_paddr[0]);
+	paddr1 = READ_ONCE(next->thread.bp_preview_paddr[1]);
+	paddr2 = READ_ONCE(next->thread.bp_preview_paddr[2]);
+	paddr3 = READ_ONCE(next->thread.bp_preview_paddr[3]);
+	if (!(paddr0 | paddr1 | paddr2 | paddr3))
+		return;
+	if (paddr0)
+		asm volatile("csrw 0x9c0, %0" : : "r"(paddr0) : "memory");
+	if (paddr1)
+		asm volatile("csrw 0x9c0, %0" : : "r"(paddr1) : "memory");
+	if (paddr2)
+		asm volatile("csrw 0x9c0, %0" : : "r"(paddr2) : "memory");
+	if (paddr3)
+		asm volatile("csrw 0x9c0, %0" : : "r"(paddr3) : "memory");
+	WRITE_ONCE(next->thread.bp_preview_hook_count,
+		   READ_ONCE(next->thread.bp_preview_hook_count) + 1);
+}
 

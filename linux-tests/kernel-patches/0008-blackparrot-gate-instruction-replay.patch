This patch gates the shared instruction-prefix launch with the incoming task's
existing preview mode. It turns the physical benchmark's mode-zero arm into a
true instruction-and-data-disabled control while modes one and two enable both.
Mode three triggers instruction replay alone and accounts for that selection in
the existing hook counter so the benchmark can retain its one-switch filter.
Mode four increments only that counter, isolating software accounting overhead
from the empty instruction-prefix hardware trigger.

--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -6649,10 +6649,21 @@ static void __sched notrace __schedule(unsigned int sched_mode)
 
 	if (likely(prev != next)) {
 #ifdef CONFIG_RISCV
-		/* Physical prefix contents are machine-owned. Launch only for an
-		 * actual task change so failed selections do not replay the table.
+		/* Physical prefix contents are machine-owned. The per-task preview
+		 * mode makes mode zero a matched instruction/data-disabled control.
+		 * Launch only for an actual task change and an enabled incoming task.
 		 */
-		asm volatile("csrw 0x5c0, zero" ::: "memory");
+		unsigned char bp_preview_mode =
+			READ_ONCE(next->thread.bp_preview_phys_mode);
+
+		if (bp_preview_mode && bp_preview_mode != 4) {
+			asm volatile("csrw 0x5c0, zero" ::: "memory");
+		}
+		/* Modes three and four skip physical data-hint CSR writes. Count
+		 * the selection here; mode four also skips the hardware trigger. */
+		if (bp_preview_mode == 3 || bp_preview_mode == 4)
+			WRITE_ONCE(next->thread.bp_preview_hook_count,
+				   READ_ONCE(next->thread.bp_preview_hook_count) + 1);
 #endif
 
 		rq->nr_switches++;

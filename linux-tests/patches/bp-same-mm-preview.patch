+/* Only a same-mm target can use the current satp translation here. The
+ * advisory hint is allowed to drop on a DTLB miss or a full hardware queue.
+ * Keep the SUM window as short as the instruction stream permits.
+ */
+static __always_inline void riscv_bp_preview_next(struct task_struct *prev,
+						  struct task_struct *next)
+{
+	unsigned long addr = READ_ONCE(next->thread.bp_preview_addr);
+	unsigned long status;
+
+	if (!addr || !prev->mm || prev->mm != next->mm ||
+	    READ_ONCE(next->thread.bp_preview_mm) != next->mm)
+		return;
+
+	status = csr_read(CSR_STATUS);
+	if (!(status & SR_SUM))
+		csr_set(CSR_STATUS, SR_SUM);
+	asm volatile("ori zero, %0, 1" : : "r"(addr) : "memory");
+	if (!(status & SR_SUM))
+		csr_clear(CSR_STATUS, SR_SUM);
+}

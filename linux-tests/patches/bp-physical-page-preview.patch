+/* All physical hints are L2-only, but their reads may outlive a switch.
+ * Stop publication before canceling the shared queue. A timeout keeps page
+ * references pinned; releasing an in-flight physical address would be unsafe.
+ * Registration is limited to one possible CPU, so this local fence covers all
+ * producers of the task's hints.
+ */
+int riscv_bp_preview_release(struct task_struct *task)
+{
+	bool pinned = false;
+	unsigned int i;
+
+	for (i = 0; i < BP_PREVIEW_ADDRS; i++)
+		pinned |= !!task->thread.bp_preview_pin[i];
+	WRITE_ONCE(task->thread.bp_preview_phys_mm, NULL);
+	for (i = 0; i < BP_PREVIEW_ADDRS; i++)
+		WRITE_ONCE(task->thread.bp_preview_paddr[i], 0);
+	if (!pinned)
+		return 0;
+
+	preempt_disable();
+	asm volatile("csrw 0x9c0, zero" : : : "memory");
+	for (i = 0; i < 65536; i++) {
+		unsigned long status;
+
+		asm volatile("csrr %0, 0x9c0" : "=r"(status) : : "memory");
+		if (status & 1)
+			break;
+	}
+	preempt_enable();
+	if (WARN_ON_ONCE(i == 65536))
+		return -ETIMEDOUT;
+
+	for (i = 0; i < BP_PREVIEW_ADDRS; i++) {
+		struct page *page = task->thread.bp_preview_pin[i];
+
+		task->thread.bp_preview_pin[i] = NULL;
+		if (page)
+			unpin_user_page(page);
+	}
+	return 0;
+}
+
+int riscv_bp_preview_replace(struct task_struct *task,
+			     struct page *pages[BP_PREVIEW_ADDRS],
+			     unsigned long paddr[BP_PREVIEW_ADDRS])
+{
+	bool any = false;
+	unsigned int i;
+	int error;
+
+	error = riscv_bp_preview_release(task);
+	if (error)
+		return error;
+	for (i = 0; i < BP_PREVIEW_ADDRS; i++) {
+		task->thread.bp_preview_pin[i] = pages[i];
+		WRITE_ONCE(task->thread.bp_preview_paddr[i], paddr[i]);
+		any |= !!pages[i];
+	}
+	WRITE_ONCE(task->thread.bp_preview_phys_mm, any ? task->mm : NULL);
+	return 0;
+}

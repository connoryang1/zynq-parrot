
include $(COSIM_MK_DIR)/Makefile.sim

SHELL := /bin/bash
.SHELLFLAGS := -o pipefail -c

DEFINES += SIMULATION

DUMP_FILE ?= dump.fst
VERILATOR_BUILD_JOBS ?= $(shell nproc)

VV_VFLAGS += $(addprefix +define+,$(filter-out VERILATOR,$(DEFINES)))
VV_VFLAGS += $(addprefix +incdir+,$(VINCLUDES))

VV_CFLAGS += $(CFLAGS)
VV_CFLAGS += $(addprefix -D,$(filter-out VERILATOR,$(DEFINES)))
VV_CFLAGS += $(addprefix -I,$(CINCLUDES))
VV_CFLAGS += $(addprefix -L,$(CLIBDIRS))

VV_LDFLAGS += $(LDFLAGS)
VV_LDFLAGS += $(addprefix -L,$(CLIBDIRS))
VV_LDFLAGS += $(addprefix -l,$(CLIBS))

VV_BUILD_OPTS += $(COSIM_VSRC_DIR)/waiver.vlt
VV_BUILD_OPTS += --cc --sv --exe --build --build-jobs $(VERILATOR_BUILD_JOBS)
VV_BUILD_OPTS += -Wno-fatal
VV_BUILD_OPTS += -top-module $(TB_MODULE)
VV_BUILD_OPTS += -CFLAGS "$(VV_CFLAGS)"
VV_BUILD_OPTS += -LDFLAGS "$(VV_LDFLAGS)"
VV_BUILD_OPTS += $(VV_VFLAGS)

VV_RUN_OPTS +=
EXTRA_RUN_ARGS ?=

run: ## runs the verilated executable
run: obj_dir/V$(TB_MODULE) | $(RUN_COLLATERAL)
	@./$< $(VV_RUN_OPTS) $(RUN_ARGS) $(EXTRA_RUN_ARGS) 2>&1 | $(TEE_I) run.log

ifneq (,$(TRACE))
RUN_ARGS += +bsg_trace=$(DUMP_FILE)
BUILD_ARGS += --trace-fst --trace-structs
BUILD_ARGS += +define+FSTON
BUILD_ARGS += +define+BSG_NONSYNTH_WAVEFORM_TRACER_ENABLE
BUILD_ARGS += +define+BSG_NONSYNTH_WAVEFORM_TRACER_DEPTH=0
BUILD_ARGS += +define+BSG_NONSYNTH_WAVEFORM_TRACER_HIER=bsg_nonsynth_zynq_testbench.dut
BUILD_ARGS += +define+BSG_NONSYNTH_WAVEFORM_TRACER_FST
endif
build: ## builds the verilated executable
build: obj_dir/V$(TB_MODULE)

# Keep the coordinator's configuration stamp: the executable name alone does
# not distinguish topology, configuration, or tracing. Still clean explicitly
# before a verification checkpoint, as documented in AGENTS.md.
# This opt-in changes the generated full-system cache topology. Presence is
# what matters for the RTL `ifdef, including an explicit macro value of zero.
MODEL_PREFETCH_BANK_TAG := $(if $(filter BP_ZYNQ_PREFETCH_TWO_BANKS BP_ZYNQ_PREFETCH_TWO_BANKS=%,$(DEFINES)),-pfbanks2,)
# Match the testbench's `ifdef semantics and effective parameter defaults.
# A bare value macro expands to 1; for repeated definitions the last one wins.
MODEL_AXI_LATENCY_DEFINE := $(lastword $(filter BP_AXI_MEM_READ_LATENCY BP_AXI_MEM_READ_LATENCY=%,$(DEFINES)))
MODEL_AXI_DEPTH_DEFINE := $(lastword $(filter BP_AXI_MEM_READ_QUEUE_DEPTH BP_AXI_MEM_READ_QUEUE_DEPTH=%,$(DEFINES)))
MODEL_AXI_LATENCY := $(if $(MODEL_AXI_LATENCY_DEFINE),$(if $(filter BP_AXI_MEM_READ_LATENCY,$(MODEL_AXI_LATENCY_DEFINE)),1,$(patsubst BP_AXI_MEM_READ_LATENCY=%,%,$(MODEL_AXI_LATENCY_DEFINE))),40)
MODEL_AXI_DEPTH := $(if $(MODEL_AXI_DEPTH_DEFINE),$(if $(filter BP_AXI_MEM_READ_QUEUE_DEPTH,$(MODEL_AXI_DEPTH_DEFINE)),1,$(patsubst BP_AXI_MEM_READ_QUEUE_DEPTH=%,%,$(MODEL_AXI_DEPTH_DEFINE))),4)
MODEL_AXI_MEM_TAG := $(if $(filter BP_AXI_MEM_PIPELINED BP_AXI_MEM_PIPELINED=%,$(DEFINES)),-axipipe-lat$(MODEL_AXI_LATENCY)-q$(MODEL_AXI_DEPTH),)
MODEL_CONFIG_TAG := nt$(NUM_THREADS)-nc$(NUM_CONTEXTS)-cfg$(CFG)-trace$(if $(TRACE),1,0)$(MODEL_PREFETCH_BANK_TAG)$(MODEL_AXI_MEM_TAG)
MODEL_CONFIG_STAMP := obj_dir/.build_config-$(MODEL_CONFIG_TAG)

$(MODEL_CONFIG_STAMP): | $(BUILD_COLLATERAL)
	@mkdir -p $(@D)
	# Retire prior stamps so A -> B -> A cannot reuse B's executable.
	@rm -f obj_dir/.build_config-*
	@touch $@

obj_dir/V$(TB_MODULE): $(MODEL_CONFIG_STAMP) $(VPACKAGES) $(VSOURCES) $(CSOURCES) | $(BUILD_COLLATERAL)
	$(VERILATOR) $(VV_BUILD_OPTS) $(BUILD_ARGS) $(filter-out obj_dir/.build_config-%,$^) 2>&1 | $(TEE_I) build.log

view: ## View the dump with GTKwave
view: dump.fst
	@$(GTKWAVE) -f $<

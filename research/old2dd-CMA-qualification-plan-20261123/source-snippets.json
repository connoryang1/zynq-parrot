          "line": 154,
          "text": "def boot_bound(text, admission):"
        },
        {
          "line": 155,
          "text": "    identity_lines(text,admission)"
        },
        {
          "line": 156,
          "text": "    require(re.search(r'allocating owned DRAM buffer with size 48234496\\b',text),'actual owned46M allocation missing')"
        },
        {
          "line": 157,
          "text": "    require(re.search(r'allocate_dram\\(\\) called with size 48234496 bytes',text),'actual allocation call size missing')"
        },
        {
          "line": 158,
          "text": "    require('Memory limited to 46MB' in text,'Linux46MB cap missing')"
        },
        {
          "line": 159,
          "text": "    require(re.search(r'Memory: \\d+K/47104K available',text),'Linux total not47104K')"
        },
        {
          "line": 160,
          "text": "    require(re.search(r'DMA32\\s+\\[mem 0x0*80000000-0x0*82dfffff\\]',text),'DMA32 bound')"
        },
        {
          "line": 161,
          "text": "    require(re.search(r'Domain0 Next Arg1\\s*:\\s*0x0*82200000\\b',text),'runtime FDT destination')"
        },
        {
          "line": 162,
          "text": "    lines = clean_lines(text)"
        },
        {
          "line": 163,
          "text": "    command = [s.split('Kernel command line:',1)[1].strip() for s in lines if 'Kernel command line:' in s]"
        },
        {
          "line": 164,
          "text": "    require(len(command)==1 and command[0].split().count('mem=46M')==1"
        },
        {
          "line": 165,
          "text": "            and command[0].split().count('rdinit=/bin/sh')==1,'bootargs bound')"
        },
        {
          "line": 166,
          "text": "    require(not KERNEL_FAILURE_MARKER.search(text) and TIMER_GUARD_MARKER not in text,'boot failure marker')"
        },

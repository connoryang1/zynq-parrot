          "text": "        phys_ptr = 0;"
        },
        {
          "line": 173,
          "text": "    zpl->shell_write(GP0_WR_CSR_DRAM_BASE, phys_ptr, mask1);"
        },
        {
          "line": 174,
          "text": "    assert((zpl->shell_read(GP0_RD_CSR_DRAM_BASE) == (int32_t)(phys_ptr)));"

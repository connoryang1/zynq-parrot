          "line": 75,
          "text": "    void *allocate_dram(unsigned long len_in_bytes,"
        },
        {
          "line": 76,
          "text": "                        unsigned long *physical_ptr) override {"
        },
        {
          "line": 77,
          "text": ""
        },
        {
          "line": 78,
          "text": "        // resets all CMA buffers across system (eek!)"
        },
        {
          "line": 79,
          "text": "        _xlnk_reset();"
        },
        {
          "line": 80,
          "text": ""
        },
        {
          "line": 81,
          "text": "        // for now, we do uncacheable to keep things simple, memory accesses go"
        },
        {
          "line": 82,
          "text": "        // straight to DRAM and"
        },
        {
          "line": 83,
          "text": "        // thus would be coherent with the PL"
        },
        {
          "line": 84,
          "text": ""
        },
        {
          "line": 85,
          "text": "        void *virtual_ptr ="
        },
        {
          "line": 86,
          "text": "            cma_alloc(len_in_bytes, 0); // 1 = cacheable, 0 = uncacheable"
        },
        {
          "line": 87,
          "text": "        assert(virtual_ptr != NULL);"
        },
        {
          "line": 88,
          "text": "        *physical_ptr = cma_get_phy_addr(virtual_ptr);"
        },
        {
          "line": 89,
          "text": "        printf(\"bsg_zynq_pl: allocate_dram() called with size %ld bytes --> \""
        },
        {
          "line": 90,
          "text": "               \"virtual \""
        },
        {
          "line": 91,
          "text": "               \"ptr=%p, physical ptr=0x%8.8lx\\n\","
        },
        {
          "line": 92,
          "text": "               len_in_bytes, virtual_ptr, *physical_ptr);"
        },
        {
          "line": 93,
          "text": "        return virtual_ptr;"
        },
        {
          "line": 94,
          "text": "    }"
        },
        {
          "line": 95,
          "text": ""
        },
        {
          "line": 96,
          "text": "    void free_dram(void *virtual_ptr) override {"
        },
        {
          "line": 97,
          "text": "        printf(\"bsg_zynq_pl: free_dram() called on virtual ptr=%p\\n\","
        },
        {
          "line": 98,
          "text": "               virtual_ptr);"
        },
        {
          "line": 99,
          "text": "        cma_free(virtual_ptr);"
        },
        {
          "line": 100,
          "text": "    }"
        }

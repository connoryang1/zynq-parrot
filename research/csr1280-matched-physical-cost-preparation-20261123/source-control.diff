diff --git a/cosim/black-parrot-example/Makefile.design b/cosim/black-parrot-example/Makefile.design
index b5ee1d0ee..e378e5eca 100644
--- a/cosim/black-parrot-example/Makefile.design
+++ b/cosim/black-parrot-example/Makefile.design
@@ -58,8 +58,8 @@ DEFINES += BP_NCPUS=$(BP_NCPUS)
 # This dedicated experiment builds real retention by default. Set 0 to
 # reproduce the legacy replay datapath; the accepted source branch is intact.
 BP_RETAINED_BUFFER ?= 1
-BP_RETAINED_I_LINES ?= 256
-BP_RETAINED_D_LINES ?= 256
+BP_RETAINED_I_LINES ?= 1280
+BP_RETAINED_D_LINES ?= 1280
 BP_RETAINED_SETS ?= 256
 DEFINES += BP_RETAINED_BUFFER=$(BP_RETAINED_BUFFER)
 DEFINES += BP_RETAINED_I_LINES=$(BP_RETAINED_I_LINES)
diff --git a/cosim/mk/Makefile.vivado b/cosim/mk/Makefile.vivado
index edf59397d..a93b59444 100644
--- a/cosim/mk/Makefile.vivado
+++ b/cosim/mk/Makefile.vivado
@@ -5,6 +5,13 @@ IMPL            ?= 1
 HANDOFF         ?= 1
 THREADS         ?= 8
 SYNTH_STRATEGY  ?=
+IMPL_OPT_DIRECTIVE ?= Explore
+ifneq ($(words $(IMPL_OPT_DIRECTIVE)),1)
+$(error IMPL_OPT_DIRECTIVE must contain exactly one allowed directive)
+endif
+ifneq ($(filter Explore ExploreArea ExploreSequentialArea,$(IMPL_OPT_DIRECTIVE)),$(IMPL_OPT_DIRECTIVE))
+$(error Unsupported IMPL_OPT_DIRECTIVE)
+endif
 IMPL_STRATEGY   ?=
 CONFIG_TCL      ?= config.tcl
 VIVADO_TCL      ?= vivado.tcl
@@ -21,6 +28,7 @@ $(CONFIG_TCL):
 	@$(ECHO) "set ::env(THREADS) {$(THREADS)}"                            >> $@
 	@$(ECHO) "set ::env(SYNTH_STRATEGY) {$(SYNTH_STRATEGY)}"              >> $@
 	@$(ECHO) "set ::env(IMPL_STRATEGY) {$(IMPL_STRATEGY)}"                >> $@
+	@$(ECHO) "set ::env(IMPL_OPT_DIRECTIVE) {$(IMPL_OPT_DIRECTIVE)}"      >> $@
 
 $(VIVADO_TCL):
 	@$(ECHO) "#### AUTOGENERATED ####"                                     > $@
diff --git a/cosim/tcl/vivado-utils.tcl b/cosim/tcl/vivado-utils.tcl
index 4a3fa19d8..3f01fd20d 100644
--- a/cosim/tcl/vivado-utils.tcl
+++ b/cosim/tcl/vivado-utils.tcl
@@ -109,6 +109,33 @@ proc vivado_impl_wrap { do_impl threads } {
             puts "BSG-INFO: implementation strategy ${strategy}"
             set_property strategy ${strategy} [get_runs impl_1]
         }
+        # Override only opt_design after the existing named strategy has
+        # populated all implementation steps; never select a new strategy.
+        set selected [vivado_env_default IMPL_OPT_DIRECTIVE "Explore"]
+        if {$selected ni {Explore ExploreArea ExploreSequentialArea}} {
+            error "unsupported IMPL_OPT_DIRECTIVE '$selected'"
+        }
+        set run [get_runs impl_1]
+        set changed_property STEPS.OPT_DESIGN.ARGS.DIRECTIVE
+        set before [dict create]
+        foreach name [lsort [list_property $run]] {
+            if {[string match STEPS.* $name] && $name ne $changed_property} {
+                dict set before $name [get_property $name $run]
+            }
+        }
+        set_property $changed_property $selected $run
+        if {[get_property $changed_property $run] ne $selected} {
+            error "Vivado lost requested opt_design directive"
+        }
+        set receipt [open implementation-selection.tsv w]
+        puts $receipt "selected_opt_directive\t$selected"
+        dict for {name expected} $before {
+            set actual [get_property $name $run]
+            puts $receipt "$name\t[list $expected]\t[list $actual]"
+            if {$actual ne $expected} {error "opt-only selection changed $name"}
+        }
+        close $receipt
+        puts "BP-IMPL-OPT-CONFIG: requested=$selected actual=[get_property $changed_property $run] other_step_properties_unchanged=1"
         launch_runs impl_1 -to_step write_bitstream -jobs ${threads}
         wait_on_run impl_1
         open_run impl_1 -name impl_1

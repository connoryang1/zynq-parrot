--- a/cosim/mk/Makefile.vivado
+++ b/cosim/mk/Makefile.vivado
@@ -5,6 +5,13 @@
 HANDOFF         ?= 1
 THREADS         ?= 8
 SYNTH_STRATEGY  ?=
+IMPL_OPT_DIRECTIVE ?= Explore
+ifneq ($(words $(IMPL_OPT_DIRECTIVE)),1)
+$(error IMPL_OPT_DIRECTIVE must contain exactly one allowed directive)
+endif
+ifneq ($(filter Explore ExploreArea ExploreSequentialArea,$(IMPL_OPT_DIRECTIVE)),$(IMPL_OPT_DIRECTIVE))
+$(error Unsupported IMPL_OPT_DIRECTIVE)
+endif
 IMPL_STRATEGY   ?=
 CONFIG_TCL      ?= config.tcl
 VIVADO_TCL      ?= vivado.tcl
@@ -21,6 +28,7 @@
 	@$(ECHO) "set ::env(THREADS) {$(THREADS)}"                            >> $@
 	@$(ECHO) "set ::env(SYNTH_STRATEGY) {$(SYNTH_STRATEGY)}"              >> $@
 	@$(ECHO) "set ::env(IMPL_STRATEGY) {$(IMPL_STRATEGY)}"                >> $@
+	@$(ECHO) "set ::env(IMPL_OPT_DIRECTIVE) {$(IMPL_OPT_DIRECTIVE)}"      >> $@
 

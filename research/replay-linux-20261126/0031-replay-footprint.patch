+/* Mode sixteen launches the same tagged data slot plus the firmware code
+ * prefix as mode ten, but at the final switch to the task (end of the
+ * previous task's turn) instead of at its wakeup. It measures the trigger
+ * point alone: the footprint and the hardware path are identical.
+ */
+static __always_inline void riscv_bp_replay_switch(struct task_struct *next)
+{
+	if (READ_ONCE(next->thread.bp_preview_phys_mode) != 16
+	    || READ_ONCE(next->thread.bp_preview_replay_state) != 1
+	    || READ_ONCE(next->thread.bp_preview_phys_mm) != next->mm
+	    || !next->mm)
+		return;
+	asm volatile("csrw 0x5c0, zero" ::: "memory");
+	asm volatile("csrw 0x9c3, %0"
+		     : : "r"((unsigned long)READ_ONCE(next->thread.bp_preview_replay_slot))
+		     : "memory");
+	WRITE_ONCE(next->thread.bp_preview_hook_count,
+		   READ_ONCE(next->thread.bp_preview_hook_count) + 1);
+}
